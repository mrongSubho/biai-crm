{
  "name": "biai-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:worker": "wrangler dev",
    "dev": "vite",
    "build:client": "vite build",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "d1:migrate:local": "wrangler d1 migrations apply biai-crm-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply biai-crm-db --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.475.0",
    "postcss": "^8.5.32",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vitest": "^3.0.6",
    "wrangler": "^3.111.0"
  }
}
